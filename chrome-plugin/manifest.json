{
  "manifest_version": 3,
  "name": "Teste Relatorio - Content Intelligence",
  "version": "3.0",
  "description": "Carrega dados de teste nos Relatorios",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teste Relatorio"
  },
  "host_permissions": ["<all_urls>"]
}
